# Provider selection: "anthropic" (default) or "deepseek".
AGENT_MODEL_PROVIDER=anthropic
AGENT_MODEL=claude-sonnet-4-20250514

# Required only for live runs.
# Anthropic provider:
ANTHROPIC_API_KEY=
# DeepSeek provider (OpenAI-compatible API):
# DEEPSEEK_API_KEY=

# Optional: route provider calls through a custom endpoint (proxy/gateway).
# AGENT_MODEL_BASE_URL=https://proxy.example.com

# Optional overrides.
AGENT_MAX_ITERATIONS=6

# Optional: JSON list of stdio MCP servers whose tool schemas are advertised to the model.
# AGENT_MCP_SERVERS=[{"name":"docs","command":"python","args":["-m","docs_server"]}]
