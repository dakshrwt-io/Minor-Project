# Provider selection: "anthropic" (default) or "deepseek".
# Both providers run through the OpenAI Agents SDK's LitellmModel.
AGENT_MODEL_PROVIDER=anthropic
AGENT_MODEL=claude-sonnet-4-20250514

# Required only for live runs.
# Anthropic provider:
ANTHROPIC_API_KEY=
# DeepSeek provider (OpenAI-compatible API):
# DEEPSEEK_API_KEY=

# Optional: route provider calls through a custom endpoint (proxy/gateway).
# AGENT_MODEL_BASE_URL=https://proxy.example.com

# Optional overrides.
AGENT_MAX_ITERATIONS=6

# Optional: SQLite database backing cross-request conversation memory.
# AGENT_SESSION_DB=data/agent-state.sqlite3

# Optional: JSON list of MCP servers whose tool schemas are advertised to the
# model. Entries launch a stdio server (name/command/args) or connect to a
# streamable-HTTP server (name/url).
# AGENT_MCP_SERVERS=[{"name":"docs","command":"python","args":["-m","docs_server"]}]
# AGENT_MCP_SERVERS=[{"name":"remote","url":"http://127.0.0.1:8000/mcp"}]