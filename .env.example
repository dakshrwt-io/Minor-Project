# Copy this file to .env and fill in your key.

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any OpenRouter model that supports tool calling.
# deepseek/deepseek-v4-flash is cheap and fast; deepseek/deepseek-v4-pro is stronger.
AGENT_MODEL=deepseek/deepseek-v4-flash

# Max model calls per message (stops endless loops).
AGENT_MAX_STEPS=10

# Where chat history is stored.
# AGENT_MEMORY_DB=data/memory.sqlite3

# Command the run_tests tool runs in the target repository (default below).
# AGENT_TEST_COMMAND=python -m pytest -q

# Optional MCP servers (JSON list). Each entry starts a local program.
# AGENT_MCP_SERVERS=[{"name": "demo", "command": "python", "args": ["examples/demo_mcp_server.py"]}]
